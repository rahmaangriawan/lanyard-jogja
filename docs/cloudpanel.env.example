# Salin file ini ke .env pada document root CloudPanel.
# Jangan commit .env asli atau mengganti APP_KEY setelah aplikasi live.

APP_NAME="Lanyard Jogja"
APP_ENV=production
APP_KEY=base64:GANTI_DENGAN_APP_KEY_PRODUCTION_ANDA
APP_DEBUG=false
APP_URL=https://lanyardjogja.com

TRUSTED_PROXIES=127.0.0.1,::1
CORS_ALLOWED_ORIGINS=https://lanyardjogja.com
HSTS_ENABLED=true
CSP_ENABLED=true

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Isi dengan kredensial database yang dibuat dari CloudPanel.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lanyard_jogja
DB_USERNAME=GANTI_DENGAN_DB_USER
DB_PASSWORD=GANTI_DENGAN_DB_PASSWORD

# Hanya dibutuhkan bila database benar-benar masih kosong saat deploy pertama.
CMS_ADMIN_NAME=Administrator
CMS_ADMIN_EMAIL=admin@lanyardjogja.com
CMS_ADMIN_PASSWORD=GANTI_DENGAN_PASSWORD_ADMIN_KUAT

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="info@lanyardjogja.com"
MAIL_FROM_NAME="${APP_NAME}"

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

VITE_APP_NAME="${APP_NAME}"
ASTRO_FRONTEND_URL=https://lanyardjogja.com
PUBLIC_SITE_URL=https://lanyardjogja.com
MEDIA_UPLOAD_DIR=../../public/uploads
